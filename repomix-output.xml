  let half = '';

  // the ladder the canvas just resolved into, landing rung by rung
  const ref = useScene<HTMLElement>((q) => {
    gsap.from(q('.plane, .planes > .eyebrow'), {
      scrollTrigger: { trigger: '.planes', start: 'top 82%' },
