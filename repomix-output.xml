/* ─────────────────────────────────────────────────────────────────────────────
   KAVACH — design system

   Two rules carry the whole page, and both encode a fact rather than a taste:

   1. COLOUR IS DETERMINISM.  steel = provable (Ed25519, integer arithmetic).
      amber = learned, advisory. bone = decided. oxide = refused, or money lost.
      The determinism gradient is therefore readable without a caption.

   2. TYPEFACE IS SPEAKER.  Mono appears only where a machine states a fact.
      Sans is where the system argues. Nothing is set in mono for atmosphere.

   The atomic primitive is the SPLIT CELL: a rectangle divided by a hairline seam,
   left half = what the rail says, right half = what is actually owed. Buttons,
   cards, planes, bars and the page-height spine are all the same object at
   different scales. The motion primitive is that seam opening and closing.
   ───────────────────────────────────────────────────────────────────────────── */

:root {
  /* ground */
  --void:  #08090a;
  --iron:  #101315;
  --seam:  #232a2e;
  --seam2: #2f383d;

  /* speech */
  --bone:  #e9e6de;
  --fog:   #79848a;
  --fog2:  #545e63;

  /* determinism */
  --steel: #7fa8c9;
  --amber: #e0a340;
  --oxide: #c1503c;

  --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Roboto, system-ui, sans-serif;
  --mono: ui-monospace, SFMono-Regular, "SF Mono", "JetBrains Mono", "IBM Plex Mono", Menlo, monospace;

  /* ── MOTION ───────────────────────────────────────────────────────────
     Durations sit on the perceptual bands: under 100ms reads as instant,
     100-300 fast, 300-500 normal, past 500 slow. */
  --t-instant: 80ms;  --t-fast: 200ms;  --t-normal: 380ms;
  --t-slow: 620ms;    --t-cinematic: 1200ms;   --t-stagger: 60ms;

  /* Easing is named for the system's epistemic posture, not for a shape. A
     fact landing and a decision hesitating are different motions, and the
     reader should feel which one happened without being told. */
  --e-proven:  cubic-bezier(.2, 0, 0, 1);        /* certain: arrives and stops */
  --e-wary:    cubic-bezier(.8, 0, .25, .95);    /* cautious: slow to commit */
  --e-refuse:  cubic-bezier(.9, 0, .05, 1);      /* an invariant: no negotiation */
  --e-reveal:  cubic-bezier(.16, .84, .28, 1);   /* content settling into place */
  --e-seam:    cubic-bezier(.62, 0, .16, 1);     /* divergence opening */

  --rail: 72px;          /* the spine gutter */
  --wrap: 1120px;
  --gut: clamp(20px, 5vw, 64px);
}

*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
/* No overflow value on html or any ancestor of .stage__sticky — it silently kills
   position: sticky inside, which turns the pinned middle of the page into blank
   scroll. Scenes that overshoot horizontally clip themselves instead. */
body {
  margin: 0; background: var(--void); color: var(--fog);
  font: 400 clamp(15px, 1.02vw, 17px)/1.65 var(--sans);
  letter-spacing: .004em;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
img, canvas { display: block; max-width: 100%; }
em { font-style: normal; color: var(--bone); }
.mono { font-family: var(--mono); font-size: .92em; letter-spacing: -.01em; }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

.skip {
  position: fixed; top: 8px; left: 8px; z-index: 99; padding: 10px 14px;
  background: var(--bone); color: var(--void); font: 600 13px var(--sans);
  transform: translateY(-160%);
}
.skip:focus { transform: none; }

:is(a, button, input, [tabindex]):focus-visible {
  outline: 2px solid var(--amber); outline-offset: 3px; border-radius: 1px;
}

/* colour-is-determinism helpers */
[data-steel] { color: var(--steel); }
[data-amber] { color: var(--amber); }
[data-oxide] { color: var(--oxide); }
[data-bone]  { color: var(--bone);  }

/* ── layout ──────────────────────────────────────────────────────────────── */
.wrap { width: min(100% - var(--gut) * 2, var(--wrap)); margin-inline: auto; }
main  { padding-left: var(--rail); }
.sec  { padding: clamp(96px, 14vh, 168px) 0; position: relative; }
.sec--planes { padding-top: clamp(40px, 6vh, 72px); }
.sec--proof  { padding-bottom: clamp(72px, 10vh, 120px); }

/* ── type scale ──────────────────────────────────────────────────────────── */
.display {
  margin: 0 0 .5em; color: var(--bone); font-weight: 500;
  font-size: clamp(2.3rem, 5.6vw, 4.15rem); line-height: 1.02;
  letter-spacing: -.036em; text-wrap: balance;
}
.display em { color: var(--steel); }
.display .w { display: inline-block; overflow: hidden; vertical-align: bottom;
  padding-bottom: .1em; margin-bottom: -.1em; }
.display .w > i { display: inline-block; font-style: inherit; }
.h2 {
  margin: .1em 0 .7em; color: var(--bone); font-weight: 500;
  font-size: clamp(1.65rem, 3.4vw, 2.7rem); line-height: 1.1;
  letter-spacing: -.028em; max-width: 20ch; text-wrap: balance;
}
.h3 {
  margin: 0 0 .6em; color: var(--bone); font-weight: 500;
  font-size: clamp(1.15rem, 1.9vw, 1.5rem); letter-spacing: -.02em;
}
.eyebrow {
  margin: 0 0 1.1em; font-family: var(--mono); font-size: 11px;
  letter-spacing: .17em; text-transform: uppercase; color: var(--fog2);
}
.lede { max-width: 56ch; font-size: 1.06rem; margin: 0 0 2.6em; }
.body { max-width: 60ch; margin: 0 0 1.4em; }
.body--tight { max-width: 48ch; }
.note { max-width: 60ch; margin: 2.4em 0 0; color: var(--fog2); font-size: .92rem; }
.note + .note { margin-top: 1em; }
.link { color: var(--fog); text-decoration: none; border-bottom: 1px solid var(--seam2); }
.link:hover { color: var(--bone); border-bottom-color: var(--bone); }
.rule { border: 0; border-top: 1px solid var(--seam); margin: clamp(64px, 9vh, 104px) 0 clamp(40px,6vh,64px); }

/* ── the spine: the event log at page scale ──────────────────────────────── */
.spine { position: fixed; inset: 0 auto 0 0; width: var(--rail); z-index: 20; pointer-events: none; }
.spine__rule { position: absolute; left: 50%; top: 0; bottom: 0; width: 1px; background: var(--seam); }
.spine__head {
  position: absolute; left: 50%; top: 0; width: 9px; height: 13px;
  margin-left: -5px; border: 1px solid var(--steel); background: var(--void);
  transform: translateY(var(--head, 0px));
}
.spine__head::after {
  content: ''; position: absolute; left: 50%; top: -1px; bottom: -1px; width: 1px;
  background: var(--steel); opacity: .5;
}
.spine__ticks { position: absolute; inset: 0; }
.spine__tick {
  position: absolute; left: 50%; width: 5px; height: 5px; margin-left: -3px;
  border: 1px solid var(--seam2); background: var(--void);
  transition: border-color var(--t-fast) var(--e-reveal), transform var(--t-fast) var(--e-reveal);
}
.spine__tick[data-on] { border-color: var(--bone); transform: scale(1.5); }

/* ── nav ─────────────────────────────────────────────────────────────────── */
.nav {
  position: fixed; top: 0; left: var(--rail); right: 0; z-index: 21;
  display: flex; align-items: center; justify-content: space-between; gap: 16px;
  padding: 18px var(--gut); font-size: 12px;
  transition: background var(--t-fast) linear, border-color var(--t-fast) linear;
  border-bottom: 1px solid transparent;
}
.nav[data-stuck] { background: color-mix(in srgb, var(--void) 88%, transparent); border-bottom-color: var(--seam); backdrop-filter: blur(10px); }
.nav__mark { display: flex; align-items: center; gap: 11px; text-decoration: none; color: var(--bone); }
/* The mark is the primitive: one object, two halves, one of them not yet known.
   Solid and outlined rather than an outlined box, which at 14px reads as a missing glyph. */
.nav__glyph { display: flex; width: 13px; height: 15px; flex: none; }
.nav__glyph::before { content: ''; width: 50%; background: var(--bone); }
.nav__glyph::after {
  content: ''; width: 50%; border: 1px solid var(--amber); border-left: 0;
}
.nav__name { font-family: var(--mono); font-size: 11px; letter-spacing: .22em; color: var(--fog); }
.nav__pos { margin: 0; font-family: var(--mono); font-size: 11px; letter-spacing: .14em; color: var(--fog2); }
.nav__slash { color: var(--seam2); }
.nav__sec { margin-left: 12px; color: var(--fog); }

/* ── the split cell, at every scale ──────────────────────────────────────── */
.cell {
  display: grid; grid-template-columns: 1fr auto 1fr;
  border: 1px solid var(--seam); background: var(--iron);
  --open: 0;                       /* 0 closed · 1 fully diverged */
}
.cell__half { padding: clamp(18px, 2.4vw, 30px); min-width: 0; }
/* No transform here. The halves are driven by the hero's scroll scene, and a CSS
   transition on the same property would lag every scrubbed frame behind the scroll.
   One animation authority per element; the seam line below carries the load-in. */
.cell__seam { position: relative; width: 1px; background: var(--seam); transform-origin: 50% 0; }
.cell__seam-line {
  position: absolute; left: 0; top: 50%; width: 1px; height: 0;
  background: var(--amber); transform: translateY(-50%);
  transition: height var(--t-cinematic) var(--e-seam), opacity var(--t-normal) linear;
  opacity: calc(var(--open) * .9);
}
.cell[data-open] { --open: 1; }
.cell[data-open] .cell__seam-line { height: 100%; }
.cell__label { margin: 0 0 .7em; font-family: var(--mono); font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--fog2); }
.cell__value { margin: 0 0 .5em; font-size: clamp(1.05rem, 2vw, 1.5rem); letter-spacing: -.02em; }
.cell__note  { margin: 0; font-size: .86rem; color: var(--fog2); max-width: 30ch; }
.cell__caption { margin: 0 0 12px; font-size: 11px; letter-spacing: .06em; color: var(--fog2); }
.cell__clock { margin: 16px 0 0; font-size: 10px; letter-spacing: .05em; color: var(--fog2); font-variant-numeric: tabular-nums; }

/* ── hero ────────────────────────────────────────────────────────────────── */
.hero { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding-top: 96px; }
.hero__body { position: relative; z-index: 2; }
.hero__cell { margin: 0 0 2.6em; max-width: 780px; }
.hero__acts { display: flex; flex-wrap: wrap; gap: 12px; }
.hero__cue {
  position: absolute; bottom: 26px; margin: 0;
  left: calc((100% - min(100% - var(--gut) * 2, var(--wrap))) / 2);
  font-family: var(--mono); font-size: 10px; letter-spacing: .28em; text-transform: uppercase;
  color: var(--fog2); animation: breathe 3.4s var(--e-reveal) infinite;
}
@keyframes breathe { 0%,100% { opacity: .35 } 50% { opacity: .9 } }

/* ambient field: the same primitive, quiet, at the smallest scale */
.hero__field {
  position: absolute; inset: 0; z-index: 1; overflow: hidden;
  -webkit-mask-image: radial-gradient(120% 90% at 78% 22%, #000 0%, transparent 72%);
          mask-image: radial-gradient(120% 90% at 78% 22%, #000 0%, transparent 72%);
  transform: translate3d(calc(var(--mx, 0) * -10px), calc(var(--my, 0) * -8px), 0);
  transition: transform 1.1s var(--e-reveal);
}
.hero__field i {
  position: absolute; width: 9px; height: 13px; border: 1px solid var(--seam);
  transition: border-color 1.2s var(--e-reveal), opacity 1.2s var(--e-reveal);
  opacity: .55;
}
.hero__field i::after { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: 1px; background: var(--seam); }
.hero__field i[data-diverged] { border-color: var(--amber); opacity: .85; }
.hero__field i[data-diverged]::after { background: var(--amber); left: calc(50% + 3px); }

/* ── buttons: the split cell that fills from its seam ────────────────────── */
.btn {
  position: relative; display: inline-flex; align-items: center; overflow: hidden;
  padding: 13px 22px; border: 1px solid var(--seam2); color: var(--bone);
  text-decoration: none; font-size: .93rem; letter-spacing: -.005em; background: transparent;
}
.btn span { position: relative; z-index: 1; transition: color var(--t-fast) var(--e-reveal); }
.btn::before {
  content: ''; position: absolute; inset: 0; background: var(--bone);
  transform: scaleX(0); transform-origin: var(--ox, 50%) 50%;
  transition: transform var(--t-fast) var(--e-seam);
}
.btn:hover::before, .btn:focus-visible::before { transform: scaleX(1); }
.btn:hover span, .btn:focus-visible span { color: var(--void); }
.btn--primary { border-color: var(--bone); }
.btn:active { transform: translateY(1px); }

/* ── transcript ──────────────────────────────────────────────────────────── */
.transcript { border-left: 1px solid var(--seam); padding: 6px 0 6px 22px; margin: 0 0 2.6em; max-width: 74ch; }
.transcript__line { display: flex; gap: 16px; margin: 0 0 .55em; align-items: baseline; }
.transcript__line:last-child { margin-bottom: 0; }
.who {
  flex: none; width: 46px; font-family: var(--mono); font-size: 10px;
  letter-spacing: .12em; text-transform: uppercase; color: var(--fog2);
}
.who--truth { color: var(--oxide); }
.said { color: var(--bone); }
.transcript__line--truth { margin-top: 1.1em; padding-top: 1.1em; border-top: 1px dashed var(--seam); }
.transcript__line--truth .mono { color: var(--oxide); }

/* ── quote ───────────────────────────────────────────────────────────────── */
.quote { margin: 0 0 3em; max-width: 62ch; }
.quote blockquote {
  --rule: 100%;
  margin: 0 0 .7em; padding-left: 22px; position: relative;
  color: var(--bone); font-size: 1.08rem; line-height: 1.5;
}
.quote blockquote::before {
  content: ''; position: absolute; left: 0; top: 0; width: 2px; height: var(--rule);
  background: var(--steel);
}
.quote figcaption { padding-left: 24px; font-family: var(--mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--fog2); }

/* ── the seam, argued in full ────────────────────────────────────────────── */
.split-claim {
  overflow-x: clip;   /* the converge-split overshoots this box on purpose */
  display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
  gap: clamp(20px, 4vw, 52px); margin: 0 0 2.6em; max-width: 940px;
  padding: clamp(24px, 3vw, 40px) 0; border-block: 1px solid var(--seam);
}
.split-claim__verdict {
  margin: 0; max-width: 8ch; text-align: center; color: var(--bone);
  font-size: clamp(.95rem, 1.4vw, 1.1rem); line-height: 1.25; letter-spacing: -.02em;
}
.claim { margin: 0 0 .5em; font-size: clamp(1rem, 1.7vw, 1.3rem); letter-spacing: -.02em; }
.split-claim__side:last-child { text-align: right; }
.split-claim__side:last-child .cell__note { margin-left: auto; }

/* ── the stage: pressure → refusal → gradient, one canvas ────────────────── */
.stage { position: relative; height: 420vh; }
.stage__sticky { position: sticky; top: 0; height: 100svh; overflow: hidden; }
.stage__canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
.stage__layer {
  position: absolute; inset: 0; display: flex; align-items: center;
  opacity: 0; pointer-events: none;
}
.stage__layer--center { justify-content: center; text-align: center; }
/* the argument holds the left column for the whole stage; the canvas keeps the
   right. 520px is the number kavach.js reads back when it places the field. */
.stage__copy { width: min(100% - var(--gut)*2, var(--wrap)); }
.stage__copy > * { max-width: 520px; }
.stage__copy .h2 { max-width: 13ch; }

.controls { list-style: none; margin: 0 0 2.2em; padding: 0; }
.controls li {
  display: grid; grid-template-columns: 150px minmax(0, 1fr);
  gap: 2px 18px; padding: 11px 0; border-top: 1px solid var(--seam);
  opacity: .18; transform: translateY(6px);
  transition: opacity var(--t-normal) var(--e-reveal), transform var(--t-normal) var(--e-reveal);
}
.controls li[data-on] { opacity: 1; transform: none; }
.ctrl__name { color: var(--steel); grid-row: span 2; }
.ctrl__what { grid-column: 2; color: var(--fog); font-size: .9rem; }
.ctrl__fail { grid-column: 2; color: var(--oxide); font-size: .9rem; }

.counter-row { display: flex; flex-wrap: wrap; gap: 20px 44px; margin: 0; }
.counter { display: flex; flex-direction: column; gap: 4px; }
.counter__n { font-size: clamp(1.5rem, 3.4vw, 2.4rem); color: var(--bone); letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
.counter__l { font-family: var(--mono); font-size: 10px; letter-spacing: .15em; text-transform: uppercase; color: var(--fog2); }

.refusal { max-width: min(860px, 84vw); }
.refusal__line {
  margin: 0; color: var(--fog2); font-weight: 500;
  font-size: clamp(1.6rem, 4.4vw, 3.2rem); line-height: 1.12; letter-spacing: -.032em;
}
.refusal__line em { color: var(--fog); }
.refusal__line--2 { color: var(--bone); }
.refusal__line--2 em { color: var(--amber); }
.refusal__sub { margin: 2.2em auto 0; max-width: 46ch; font-size: .95rem; color: var(--fog2); }

/* ── planes ──────────────────────────────────────────────────────────────── */
.legend { display: flex; flex-wrap: wrap; gap: 10px 26px; margin: 0 0 26px; font-family: var(--mono); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--fog2); }
.legend__k { display: inline-flex; align-items: center; gap: 9px; }
.legend i { width: 8px; height: 12px; border: 1px solid currentColor; }
.legend i[data-swatch="steel"] { color: var(--steel); }
.legend i[data-swatch="amber"] { color: var(--amber); }
.legend i[data-swatch="bone"]  { color: var(--bone);  }
.legend__hint { margin-left: auto; color: var(--seam2); }

.planes { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--seam); }
.plane { border-bottom: 1px solid var(--seam); position: relative; transition: background var(--t-fast) linear; }
.plane__row {
  display: grid; grid-template-columns: 40px minmax(140px, 1.1fr) minmax(180px, 2fr) 118px 76px 62px 22px;
  gap: 6px 22px; align-items: baseline; padding: 18px 12px 18px 0;
  cursor: pointer; list-style: none;
}
.plane__row {
  width: 100%; background: none; border: 0; font: inherit; color: inherit; text-align: left;
}
.plane__row:hover .plane__x::before, .plane__row:hover .plane__x::after { background: var(--k); }
/* the affordance is the primitive: a closed seam that opens */
.plane__x { position: relative; justify-self: end; align-self: center; width: 11px; height: 11px; }
.plane__x::before, .plane__x::after {
  content: ''; position: absolute; inset: 0; margin: auto; background: var(--fog2);
  transition: transform var(--t-normal) var(--e-seam), background var(--t-fast) linear;
}
.plane__x::before { width: 1px; height: 11px; }
.plane__x::after  { width: 11px; height: 1px; transform: scaleX(0); }
.plane[data-open] .plane__x::before { transform: scaleY(0); }
.plane[data-open] .plane__x::after  { transform: scaleX(1); background: var(--k); }
.plane__body {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 20px 34px; padding: 4px 12px 26px 40px;
}
.plane__body div { border-top: 1px solid var(--seam); padding-top: 12px; }
.plane__body dt {
  font-family: var(--mono); font-size: 10px; letter-spacing: .14em;
  text-transform: uppercase; color: var(--fog2); margin-bottom: 7px;
}
.plane__body dd { margin: 0; font-size: .88rem; color: var(--fog); overflow-wrap: anywhere; }
.plane__body div:first-child dt { color: var(--k); }
.plane__body div:nth-child(2) dt { color: var(--oxide); }
.plane__body div:nth-child(4) dt { color: var(--fog2); }
.plane::before {
  content: ''; position: absolute; left: -12px; top: 0; bottom: 0; width: 2px;
  background: var(--k); transform: scaleY(0); transform-origin: 50% 50%;
  transition: transform var(--t-fast) var(--e-seam);
}
.plane:hover, .plane:focus-within, .plane[data-open] { background: var(--iron); }
.plane:hover::before, .plane:focus-within::before { transform: scaleY(1); }
.plane__n { font-family: var(--mono); font-size: 11px; color: var(--fog2); letter-spacing: .06em; }
.plane__t { color: var(--bone); font-size: 1rem; letter-spacing: -.015em; }
.plane__m { color: var(--fog); font-size: .88rem; }
.plane__ai, .plane__ms { font-family: var(--mono); font-size: 11px; letter-spacing: .06em; text-align: right; white-space: nowrap; }
.plane__ai { color: var(--k); }
.plane__ms { color: var(--fog2); font-variant-numeric: tabular-nums; }
.plane__st {
  font-family: var(--mono); font-size: 10px; letter-spacing: .1em; text-transform: uppercase;
  text-align: right; color: var(--fog2); opacity: .7;
}
.plane__st[data-built] { color: var(--k); opacity: 1; }
.plane[data-k="steel"] { --k: var(--steel); }
.plane[data-k="amber"] { --k: var(--amber); }
.plane[data-k="bone"]  { --k: var(--bone);  }

/* ── instruments ─────────────────────────────────────────────────────────── */
.rig {
  display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
  gap: clamp(28px, 5vw, 72px); align-items: start;
  padding: clamp(24px, 3.4vw, 40px); border: 1px solid var(--seam); background: var(--iron);
}
.rig__controls { display: flex; flex-direction: column; gap: 26px; }
.rig--el { grid-template-areas: "ctl out" "note note"; row-gap: clamp(22px, 3vw, 34px); }
.rig--el .rig__controls { grid-area: ctl; }
.rig--el .rig__out { grid-area: out; }
.rig--el .assume { grid-area: note; padding-top: 20px; border-top: 1px solid var(--seam); }
.ctl { display: block; }
.ctl__set { border: 0; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 9px; }
.ctl__label { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 12px; padding: 0; font-family: var(--mono); font-size: 10px; letter-spacing: .15em; text-transform: uppercase; color: var(--fog2); }
.ctl__val { color: var(--bone); letter-spacing: 0; font-variant-numeric: tabular-nums; }
.chk { display: flex; align-items: center; gap: 10px; font-size: .9rem; color: var(--fog); cursor: pointer; }
.chk input { accent-color: var(--steel); width: 14px; height: 14px; }

input[type="range"] { -webkit-appearance: none; appearance: none; width: 100%; height: 15px; background: transparent; cursor: ew-resize; }
input[type="range"]::-webkit-slider-runnable-track { height: 1px; background: var(--seam2); }
input[type="range"]::-moz-range-track { height: 1px; background: var(--seam2); }
input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none; appearance: none; width: 9px; height: 15px; margin-top: -7px;
  background: var(--void); border: 1px solid var(--bone);
}
input[type="range"]::-moz-range-thumb { width: 9px; height: 15px; background: var(--void); border: 1px solid var(--bone); border-radius: 0; }

.ladder { list-style: none; margin: 0 0 22px; padding: 0; }
.ladder li {
  display: grid; grid-template-columns: 22px 1fr auto; gap: 14px; align-items: baseline;
  padding: 10px 12px 10px 0; border-bottom: 1px solid var(--seam);
  transition: color var(--t-fast) linear, background var(--t-fast) linear;
}
.rung__n { color: var(--fog2); font-size: 11px; }
.rung__t { color: var(--fog); font-size: .95rem; }
.rung__s { font-size: 11px; letter-spacing: .1em; color: var(--fog2); }
.ladder li[data-fired="deny"]     { background: color-mix(in srgb, var(--oxide) 12%, transparent); }
.ladder li[data-fired="deny"] .rung__t, .ladder li[data-fired="deny"] .rung__s { color: var(--oxide); }
.ladder li[data-fired="escalate"] { background: color-mix(in srgb, var(--amber) 10%, transparent); }
.ladder li[data-fired="escalate"] .rung__t, .ladder li[data-fired="escalate"] .rung__s { color: var(--amber); }
.ladder li[data-fired="pass"] .rung__s { color: var(--fog2); }

.verdict { display: grid; gap: 8px; padding: 20px; border: 1px solid var(--seam2); }
.verdict__k { font-family: var(--mono); font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--fog2); }
.verdict__v { font-size: clamp(1.4rem, 3vw, 2rem); letter-spacing: -.02em; color: var(--bone); }
.verdict__why { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; max-width: 58ch; }
.verdict__why li {
  font-size: .8rem; line-height: 1.5; color: var(--fog); padding-left: 14px;
  border-left: 1px solid var(--seam2);
}
.verdict[data-v="DENY"] .verdict__why li     { border-left-color: var(--oxide); }
.verdict[data-v="ESCALATE"] .verdict__why li { border-left-color: var(--amber); }
.assume--ctx { padding-top: 18px; border-top: 1px solid var(--seam); }

/* the tool surface: same names as razorpay-mcp-server, different return types */
.tools { list-style: none; margin: 22px 0 18px; padding: 0; border-top: 1px solid var(--seam); }
.tools li {
  display: grid; grid-template-columns: 200px 84px minmax(0, 1fr); gap: 4px 20px;
  align-items: baseline; padding: 10px 0; border-bottom: 1px solid var(--seam);
}
.tools__n { color: var(--steel); font-size: .84rem; }
.tools__k { font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--fog2); }
.tools__d { font-size: .86rem; color: var(--fog); }
.tools li[data-write] .tools__n { color: var(--amber); }
.tools li[data-write] .tools__k { color: var(--amber); }
.verdict[data-v="DENY"]     { border-color: var(--oxide); }
.verdict[data-v="DENY"]     .verdict__v { color: var(--oxide); }
.verdict[data-v="ESCALATE"] { border-color: var(--amber); }
.verdict[data-v="ESCALATE"] .verdict__v { color: var(--amber); }

.assume { margin: 0; font-size: .78rem; line-height: 1.6; color: var(--fog2); }
.bars { list-style: none; margin: 0 0 18px; padding: 0; display: grid; gap: 10px; }
.bars li { display: grid; grid-template-columns: 92px 1fr 88px; gap: 16px; align-items: center; }
.bar__k { font-size: 11px; letter-spacing: .1em; color: var(--fog2); transition: color var(--t-fast) linear; }
.bar__t { display: block; height: 13px; border: 1px solid var(--seam); position: relative; }
.bar__t i { position: absolute; inset: 0 auto 0 0; width: var(--w, 0%); background: var(--seam2); transition: width var(--t-normal) var(--e-reveal), background var(--t-fast) linear; }
.bar__v { font-size: 11px; text-align: right; color: var(--fog2); font-variant-numeric: tabular-nums; transition: color var(--t-fast) linear; }
.bars li[data-win] .bar__k, .bars li[data-win] .bar__v { color: var(--bone); }
.bars li[data-win] .bar__t { border-color: var(--bone); }
.bars li[data-win] .bar__t i { background: var(--bone); }
.formula { margin: 0; font-size: 11px; color: var(--fog2); letter-spacing: .02em; }

.stream {
  margin: 36px 0 0; padding: clamp(20px, 2.6vw, 30px);
  border: 1px solid var(--seam); background: var(--iron);
}
.stream__head { display: flex; flex-wrap: wrap; gap: 6px 20px; justify-content: space-between; align-items: baseline; }
.stream__head .eyebrow { margin: 0; }
.stream__src { margin: 0; font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--fog2); }
.stream__rows { list-style: none; margin: 16px 0 0; padding: 0; border-top: 1px solid var(--seam); }
.stream__rows li {
  display: grid; grid-template-columns: 84px minmax(0, 1fr) 56px 100px 52px;
  gap: 4px 18px; align-items: baseline; padding: 11px 0 11px 14px;
  border-bottom: 1px solid var(--seam); position: relative; overflow: hidden;
  animation: rowIn var(--t-normal) var(--e-reveal) both;
}
@keyframes rowIn { from { opacity: 0; transform: translateY(-7px); } }
.stream__rows li::before {
  content: ''; position: absolute; left: 0; top: 10px; bottom: 10px; width: 1px;
  background: var(--seam2); transition: background var(--t-fast) var(--e-proven);
}
.stream__rows li[data-v="ALLOW"]::before    { background: var(--steel); }
.stream__rows li[data-v="ESCALATE"]::before { background: var(--amber); }
.stream__rows li[data-v="DENY"]::before     { background: var(--oxide); }
/* a seam travelling the row: the system looking for where the halves disagree */
.s__scan { position: absolute; left: 0; top: 7px; bottom: 7px; width: 100%; pointer-events: none;
  animation: seamScan 340ms var(--e-wary) infinite; }
.s__scan::after { content: ''; position: absolute; inset: 0 auto 0 0; width: 1px; background: var(--bone); opacity: .45; }
@keyframes seamScan { from { transform: translateX(0); } to { transform: translateX(100%); } }
.s__id   { font-size: 11px; color: var(--fog2); }
.s__what { font-size: .88rem; color: var(--fog); }
.s__risk { font-size: 11px; color: var(--fog2); text-align: right; font-variant-numeric: tabular-nums; }
.s__ms   { font-size: 10px; color: var(--fog2); text-align: right; font-variant-numeric: tabular-nums; }
.s__v    { font-size: 11px; letter-spacing: .1em; color: var(--fog2); }
li[data-v="ALLOW"]    .s__v { color: var(--steel); }
li[data-v="ESCALATE"] .s__v { color: var(--amber); }
li[data-v="DENY"]     .s__v { color: var(--oxide); }
.stream__tally { display: flex; flex-wrap: wrap; gap: 10px 30px; margin: 18px 0 0; }
.stream__tally div { display: flex; align-items: baseline; gap: 9px; }
.stream__tally dt { font: 10px/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--fog2); }
.stream__tally dd { margin: 0; font-family: var(--mono); font-size: .95rem; color: var(--bone); font-variant-numeric: tabular-nums; }
.stream__note { margin: 20px 0 0; padding-top: 16px; border-top: 1px solid var(--seam); font-size: .8rem; color: var(--fog2); max-width: 76ch; }

/* ── results ─────────────────────────────────────────────────────────────── */
.results { width: 100%; border-collapse: collapse; margin: 0 0 2em; font-variant-numeric: tabular-nums; }
.results th, .results td { padding: 14px 12px; text-align: right; border-bottom: 1px solid var(--seam); }
.results th:first-child, .results td:first-child { text-align: left; padding-left: 0; }
.results thead th { font-family: var(--mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--fog2); font-weight: 400; border-bottom-color: var(--seam2); }
.results td { font-family: var(--mono); font-size: .84rem; color: var(--fog); }
.results td:first-child { font-family: var(--sans); font-size: .95rem; color: var(--fog); }
.results tr[data-hero] td { color: var(--bone); }
.results tr[data-hero] td:first-child { color: var(--bone); }
.results td[data-leak] { color: var(--oxide); }
.results tr[data-hero] td[data-leak] { color: var(--bone); }
.leak { position: relative; display: inline-block; padding: 2px 0 11px; min-width: 84px; }
.leak__bar {
  position: absolute; left: auto; right: 0; bottom: 0; height: 3px;
  background: var(--oxide); transform-origin: 100% 50%; opacity: .7;
}
tr[data-hero] .leak__bar { background: var(--bone); opacity: .9; }

.punch { max-width: 58ch; margin: 0 0 3.4em; font-size: 1.06rem; color: var(--fog); }

.sweep { padding: clamp(24px, 3vw, 34px); border: 1px solid var(--seam); background: var(--iron); margin: 0 0 3.4em; }
.sweep__ctl { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 24px; }
.sweep__btn {
  padding: 9px 16px; border: 1px solid var(--seam2); background: transparent;
  color: var(--fog); font: 400 12px/1 var(--mono); letter-spacing: .08em; cursor: pointer;
  transition: color var(--t-instant) linear, border-color var(--t-instant) linear;
}
.sweep__btn:hover { color: var(--bone); }
.sweep__btn[aria-pressed="true"] { color: var(--void); background: var(--bone); border-color: var(--bone); }
.sweep__out { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 22px; margin: 0; }
.sweep__out dt { font-family: var(--mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--fog2); margin-bottom: 7px; }
.sweep__out dd { margin: 0; font-family: var(--mono); font-size: clamp(1.15rem, 2.2vw, 1.5rem); color: var(--bone); letter-spacing: -.02em; font-variant-numeric: tabular-nums; }

.limits ul { margin: 0; padding: 0; list-style: none; max-width: 66ch; }
.limits li { padding: 14px 0; border-top: 1px solid var(--seam); font-size: .93rem; }

/* ── proof ───────────────────────────────────────────────────────────────── */
/* the append-only log for one entity, with the events the fact actually cites */
.chain { margin: 0 0 2.6em; max-width: 900px; }
.chain__log { list-style: none; margin: 0 0 18px; padding: 0; border-top: 1px solid var(--seam); }
.chain__log li {
  display: grid; grid-template-columns: 64px minmax(150px, 1fr) minmax(180px, 1.3fr) 124px;
  gap: 4px 20px; align-items: baseline; padding: 12px 0 12px 16px;
  border-bottom: 1px solid var(--seam); position: relative;
}
.chain__log li::before {
  content: ''; position: absolute; left: 0; top: 12px; bottom: 12px; width: 1px; background: var(--seam2);
}
.chain__log li[data-cited]::before { background: var(--steel); }
.chain__log li[data-absent] { opacity: .62; }
.chain__log li[data-absent] .chain__says { color: var(--amber); }
.chain__seq { color: var(--fog2); font-size: 11px; letter-spacing: .04em; }
.chain__src { color: var(--fog); font-size: .82rem; }
.chain__says { color: var(--fog); font-size: .9rem; }
.chain__trust { font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--fog2); text-align: right; }
.chain__fact { margin: 0; padding-left: 16px; font-size: .8rem; color: var(--fog2); }

.facts { margin: 0 0 3em; display: grid; gap: 0; max-width: 70ch; }
.facts > div { display: grid; grid-template-columns: minmax(160px, 220px) 1fr; gap: 22px; padding: 14px 0; border-top: 1px solid var(--seam); }
.facts dt { color: var(--steel); font-size: .84rem; }
.facts > div:nth-child(2) dt { color: var(--fog); }
.facts > div:nth-child(3) dt { color: var(--amber); }
.facts dd { margin: 0; font-size: .93rem; }

.swap { padding: clamp(24px, 3vw, 36px); border: 1px solid var(--seam); background: var(--iron); }
.code { margin: 18px 0 0; padding: 16px 18px; background: var(--void); border: 1px solid var(--seam); overflow-x: auto; font-size: .82rem; color: var(--steel); }

/* ── foot ────────────────────────────────────────────────────────────────── */
.foot { border-top: 1px solid var(--seam); padding: 34px 0; margin-left: var(--rail); }
.foot__in { display: flex; flex-wrap: wrap; gap: 14px 32px; justify-content: space-between; align-items: baseline; }
.foot__mark { margin: 0; color: var(--bone); font-size: .95rem; display: flex; align-items: center; gap: 10px; }
.foot__meta { margin: 0; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--fog2); }

/* ── reveal ──────────────────────────────────────────────────────────────── */
[data-reveal] { opacity: 0; transform: translateY(14px); }
[data-reveal][data-shown] {
  opacity: 1; transform: none;
  transition: opacity var(--t-slow) var(--e-reveal), transform var(--t-slow) var(--e-reveal);
  transition-delay: var(--delay, 0s);
}

/* ── responsive: a different composition, not a smaller one ──────────────── */
@media (max-width: 860px) {
  :root { --rail: 0px; }
  main, .foot { padding-left: 0; margin-left: 0; }
  .nav { left: 0; }
  .nav__sec { display: none; }
  .spine { inset: 0 0 auto 0; width: auto; height: 2px; }
  .spine__rule { left: 0; right: 0; top: 0; bottom: auto; width: auto; height: 1px; }
  .spine__head { left: 0; top: 0; width: var(--prog, 0%); height: 2px; margin: 0; border: 0; background: var(--steel); transform: none; }
  .spine__head::after, .spine__ticks { display: none; }

  .hero { min-height: auto; padding: 132px 0 88px; }
  .hero__cue { display: none; }
  .cell { grid-template-columns: 1fr; }
  .cell__seam { width: auto; height: 1px; }
  .cell__seam-line { left: 50%; top: 0; width: 0; height: 1px; transform: translateX(-50%); transition: width var(--t-cinematic) var(--e-seam); }
  .cell[data-open] .cell__seam-line { height: 1px; width: 100%; }

  .split-claim { grid-template-columns: 1fr; text-align: left; }
  .split-claim__verdict { max-width: none; text-align: left; }
  .split-claim__side:last-child { text-align: left; }
  .split-claim__side:last-child .cell__note { margin-left: 0; }

  .stage { height: 360vh; }
  .stage__layer { align-items: flex-start; padding-top: 84px; }
  .stage__layer--center { align-items: center; padding-top: 0; }
  .stage__copy > *, .stage__copy .h2 { max-width: none; }
  .controls li { grid-template-columns: 1fr; gap: 3px; }
  .controls li .ctrl__name { grid-row: auto; }
  .ctrl__what, .ctrl__fail { grid-column: 1; }
  .plane__m { grid-column: 2; }
  .plane__ai, .plane__ms { grid-column: 2; text-align: left; }
  .rig { grid-template-columns: 1fr; }
  .plane__row { grid-template-columns: 30px 1fr 22px; gap: 4px 14px; }
  .plane__st { grid-column: 2; text-align: left; }
  .plane__body { padding-left: 16px; }
  .stream__rows li { grid-template-columns: 1fr 88px; }
  .tools li { grid-template-columns: 1fr 84px; }
  .tools__d { grid-column: 1 / -1; }
  .s__id { grid-column: 1; } .s__what { grid-column: 1 / -1; }
  .s__risk, .s__ms { text-align: left; }
  .s__risk { grid-column: 1; } .s__v { grid-column: 2; text-align: right; } .s__ms { display: none; }
  .rig--el { grid-template-areas: "ctl" "out" "note"; }
  .results th:nth-child(2), .results td:nth-child(2),
  .results th:nth-child(3), .results td:nth-child(3) { display: none; }
  .bars li { grid-template-columns: 78px 1fr 74px; gap: 10px; }
  .facts > div { grid-template-columns: 1fr; gap: 5px; }
  .chain__log li { grid-template-columns: 60px 1fr; }
  .chain__says, .chain__trust { grid-column: 2; text-align: left; }
}

/* ── reduced motion: keep every state change, drop the theatre ───────────── */
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; }
  [data-reveal] { opacity: 1; transform: none; }
  .hero__field { display: none; }
  .stage { height: auto; }
  /* the beats read in narrative order, with the resolved gradient last */
  .stage__sticky { position: static; height: auto; overflow: visible; display: flex; flex-direction: column; }
  .stage__canvas { position: relative; height: 46vh; order: 9; margin-bottom: 48px; }
  .stage__layer { position: static; opacity: 1; pointer-events: auto; padding: 64px 0; }
  .stage__copy--top { padding-top: 0; }
  .controls li { opacity: 1; transform: none; }
}

/* ── degraded: the bundle never ran ──────────────────────────────────────────
   Reveal what the prerender hid. Scoped to the inline entrance states Motion
   emits, so deliberate dimming elsewhere is left alone. */
html[data-degraded] [style*="opacity:0"] { opacity: 1 !important; }
html[data-degraded] [style*="translateY"],
html[data-degraded] [style*="translateX"] { transform: none !important; }
html[data-degraded] .stage { height: auto; }
html[data-degraded] .stage__sticky {
  position: static; height: auto; overflow: visible; display: flex; flex-direction: column;
}
html[data-degraded] .stage__canvas { position: relative; height: 40vh; order: 9; margin-bottom: 48px; }
html[data-degraded] .stage__layer {
  position: static; opacity: 1; pointer-events: auto; padding: 64px 0; transform: none;
}
html[data-degraded] .hero__field { display: none; }

.offline { display: none; }
html[data-file] .offline {
  display: block; position: sticky; top: 0; z-index: 40; margin: 0;
  padding: 12px var(--gut); border-bottom: 1px solid var(--amber);
  background: color-mix(in srgb, var(--amber) 12%, var(--void));
  color: var(--bone); font-size: .85rem;
}
