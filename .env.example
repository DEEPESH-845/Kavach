# Kavach configuration. Copy to .env; never commit .env.
#
# ── required for a real payment (Razorpay TEST mode only) ───────────────────────────
# Test-mode keys from https://dashboard.razorpay.com -> Settings -> API Keys.
# Kavach refuses a live key (rzp_live_...) for the demo: checkout only runs in test mode.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# `live` reaches the Razorpay API with the keys above; `replay` (default) never leaves the
# machine and checkout reports itself unavailable rather than faking a payment.
KAVACH_MODE=live

# ── optional: signed webhooks upgrade payment truth to DERIVED_CERTAIN ───────────────
# Dashboard -> Webhooks -> URL https://<your-host>/api/webhooks/razorpay, events
# payment.captured and refund.processed. Without a secret every webhook is refused
# (fail-closed) and payments observed by polling stay DERIVED_PROBABLE -- shown honestly.
RAZORPAY_WEBHOOK_SECRET=

# ── optional: where things live and what is switched on ─────────────────────────────
# The event log. Point it at a mounted disk to keep the ledger across restarts.
KAVACH_DB=kavach.db
# Enables POST /api/demo/reset (the "Reset demo" button). Off in a real deployment.
KAVACH_DEMO=1
# Container only: re-seed the ledger on every start even if one exists.
KAVACH_SEED_ON_START=
# Suspends autonomous money movement; every refund intent goes to a human.
KAVACH_KILL_SWITCH=
# Per-client requests per minute on the endpoints a QR code can drive.
KAVACH_RATE_LIMIT=60
# kavach-mcp-server defaults (also accepted as --toolsets / --read-only).
KAVACH_TOOLSETS=
KAVACH_READ_ONLY=
