# Kavach configuration. Copy to .env; never commit .env.
#
# ── required for a real payment (Razorpay TEST mode only) ───────────────────────────
# Test-mode keys from https://dashboard.razorpay.com -> Settings -> API Keys.
# Kavach refuses a live key (rzp_live_...) for the demo: checkout only runs in test mode.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# `live` reaches the Razorpay API with the keys above; `replay` (default) never leaves the
# machine and checkout reports itself unavailable rather than faking a payment.
KAVACH_MODE=live

# ── optional: signed webhooks upgrade payment truth to DERIVED_CERTAIN ───────────────
# Dashboard -> Webhooks -> URL https://<your-host>/api/webhooks/razorpay, events
# payment.captured and refund.processed. Without a secret every webhook is refused
# (fail-closed) and payments observed by polling stay DERIVED_PROBABLE -- shown honestly.
RAZORPAY_WEBHOOK_SECRET=

# ── optional: where things live and what is switched on ─────────────────────────────
# The event log: a SQLite file (point it at a mounted disk to keep the ledger across
# restarts) or a postgresql://user:pass@host/db URL for more than one node.
KAVACH_DB=kavach.db
# 1 mounts the demo surfaces (storefront, duel, lab, tamper, console MCP, the "Reset demo"
# button) and turns API keys off by default. Leave unset for a real deployment.
KAVACH_DEMO=1
# required | off. Defaults to required, or off when KAVACH_DEMO=1. With keys required every
# /api route wants `Authorization: Bearer kv_...`; mint one with
#   python -m kavach keys create --name ops --scope operator
KAVACH_AUTH=
# Locks /api/metrics behind a separate scrape secret (bearer or ?key=). Unset = public.
KAVACH_METRICS_KEY=
# Container only: re-seed the ledger on every start even if one exists.
KAVACH_SEED_ON_START=
# Path to a TOML policy file (see kavach.example.toml): caps, thresholds, gate economics,
# per-agent tiers, rate limit, CORS. Unset = compiled defaults.
KAVACH_POLICY=
# Suspends autonomous money movement; every refund intent goes to a human. Wins over the file.
KAVACH_KILL_SWITCH=
# Trust X-Forwarded-For for rate-limiting. Only set this behind a proxy that itself sets
# the header (Railway, Render, Fly, Cloud Run); unset elsewhere or a client can spoof a
# fresh rate-limit bucket per request by varying the header.
KAVACH_TRUST_PROXY=
# Reconciler: seconds between passes on a background thread; 0 disables. Default 60 in live
# mode, 0 in replay (there is no provider to reconcile against).
KAVACH_RECONCILE_INTERVAL=
# text | json (one object per line with request id, route, status, latency, key name)
KAVACH_LOG_FORMAT=
# Optional error and trace sinks; nothing is imported until these are set.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
# Per-client requests per minute on the endpoints a QR code can drive.
KAVACH_RATE_LIMIT=60
# Extra browser origins allowed to call the API, comma-separated. Only needed when the UI
# is hosted elsewhere (e.g. Vercel) with NEXT_PUBLIC_KAVACH_API pointing at this server.
KAVACH_CORS_ORIGINS=
# ── optional: sending the step-up link to the principal ──────────────────────────────
# The public origin of this deployment, used to build the approval link in messages.
KAVACH_PUBLIC_URL=
# email: smtp://user:pass@host:587?from=kavach@example.com (STARTTLS) or smtps://...:465
KAVACH_SMTP_URL=
# sms / whatsapp via Twilio (one POST over urllib; no SDK)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=
TWILIO_FROM_WHATSAPP=
# webhook: Kavach POSTs {to, message, token, approve_url, ...} here, HMAC-signed with the
# secret in X-Kavach-Signature, so any channel you run is one adapter away on your side.
KAVACH_STEPUP_WEBHOOK_URL=
KAVACH_STEPUP_WEBHOOK_SECRET=

# kavach-mcp-server defaults (also accepted as --toolsets / --read-only).
KAVACH_TOOLSETS=
KAVACH_READ_ONLY=
